<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_country_group"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="14dp"
    app:cardBackgroundColor="@color/surface_card"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Accordion Header -->
        <LinearLayout
            android:id="@+id/layout_country_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <!-- Country Flag Frame -->
            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_flag_frame"
                android:padding="1dp"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/iv_country_flag"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/flag_global"
                    android:contentDescription="国家国旗" />
            </FrameLayout>

            <!-- Country Name -->
            <TextView
                android:id="@+id/tv_country_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="日本"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Node Count Badge -->
            <TextView
                android:id="@+id/tv_country_node_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/badge_rounded_bg"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:text="3"
                android:textColor="@color/brand_primary"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Single-Country One-Click Speed Test Button ⚡ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_country_speed_test"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:text="⚡"
                android:textSize="12sp"
                android:textColor="@color/brand_primary"
                app:cornerRadius="8dp" />

            <!-- Expand / Collapse Arrow -->
            <TextView
                android:id="@+id/tv_country_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="▼"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Divider line -->
        <View
            android:id="@+id/divider_country"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/card_stroke" />

        <!-- Expanded Nodes List -->
        <LinearLayout
            android:id="@+id/layout_country_nodes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="4dp"
            android:visibility="visible" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
